@model IEnumerable<HRRecruitment.Models.Applicant>
@{
    ViewData["Title"] = "Applicants";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1"><i class="fas fa-users me-2 text-success"></i>Applicant Management</h4>
                        <p class="text-muted mb-0">Manage all job applicants</p>
                    </div>
                    <a href="@Url.Action("CreateApplicant", "HR")" class="btn btn-success">
                        <i class="fas fa-plus me-2"></i>Add New Applicant
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="fas fa-search text-success"></i>
                                </span>
                                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                                       class="form-control" placeholder="Search by name, email, or applicant number...">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="status" class="form-select">
                                <option value="All">All Status</option>
                                <option value="Not in Process" selected="@(ViewBag.CurrentStatus == "Not in Process")">Not in Process</option>
                                <option value="In Process" selected="@(ViewBag.CurrentStatus == "In Process")">In Process</option>
                                <option value="Hired" selected="@(ViewBag.CurrentStatus == "Hired")">Hired</option>
                                <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">Rejected</option>
                                <option value="Banned" selected="@(ViewBag.CurrentStatus == "Banned")">Banned</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-filter me-2"></i>Filter
                            </button>
                        </div>
                        <div class="col-md-2">
                            <a href="@Url.Action("Applicants", "HR")" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-redo me-2"></i>Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Applicants List -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Applicant #</th>
                                        <th>Full Name</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Qualification</th>
                                        <th>Experience</th>
                                        <th>Status</th>
                                        <th>Applied Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var applicant in Model)
                                    {
                                        <tr>
                                            <td><strong>@applicant.ApplicantNumber</strong></td>
                                            <td>@applicant.FirstName @applicant.LastName</td>
                                            <td>@applicant.Email</td>
                                            <td>@applicant.Phone</td>
                                            <td>@(applicant.HighestQualification ?? "-")</td>
                                            <td>@(applicant.ExperienceYears?.ToString() ?? "0") yrs</td>
                                            <td>
                                                @if (applicant.Status == "Hired")
                                                {
                                                    <span class="badge bg-success">Hired</span>
                                                }
                                                else if (applicant.Status == "In Process")
                                                {
                                                    <span class="badge bg-primary">In Process</span>
                                                }
                                                else if (applicant.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                                else if (applicant.Status == "Banned")
                                                {
                                                    <span class="badge bg-dark">Banned</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@applicant.Status</span>
                                                }
                                            </td>
                                            <td>@applicant.CreatedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("EditApplicant", "HR", new { id = applicant.ApplicantId })"
                                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (applicant.Status != "Hired" && applicant.Status != "Banned")
                                                    {
                                                        <a href="@Url.Action("AttachApplicant", "HR", new { id = applicant.ApplicantId })"
                                                           class="btn btn-sm btn-outline-success" title="Attach to Vacancy">
                                                            <i class="fas fa-link"></i>
                                                        </a>
                                                    }
                                                    @if (applicant.ResumePath != null)
                                                    {
                                                        <a href="@applicant.ResumePath" target="_blank"
                                                           class="btn btn-sm btn-outline-info" title="View Resume">
                                                            <i class="fas fa-file-pdf"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No applicants found</h5>
                            <p class="text-muted mb-3">Get started by adding your first applicant</p>
                            <a href="@Url.Action("CreateApplicant", "HR")" class="btn btn-success">
                                <i class="fas fa-plus me-2"></i>Add New Applicant
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>