@model HRRecruitment.ViewModels.CreateVacancyViewModel
@{
    ViewData["Title"] = "Create Vacancy";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}
<div class="container-fluid px-4">
    <div class="row mb-4"><div class="col-12"><div class="card shadow"><div class="card-body d-flex justify-content-between align-items-center"><div><h4 class="mb-1"><i class="fas fa-plus-circle me-2 text-primary"></i>Create New Vacancy</h4><p class="text-muted mb-0">Fill in the details to create a new job vacancy</p></div><a href="@Url.Action("Vacancies", "HR")" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Vacancies</a></div></div></div></div>
    <div class="row"><div class="col-12"><div class="card shadow"><div class="card-body"><form asp-action="CreateVacancy" method="post">@Html.AntiForgeryToken()<div class="row"><div class="col-md-8 mb-3"><label asp-for="JobTitle" class="form-label">Job Title <span class="text-danger">*</span></label><input asp-for="JobTitle" class="form-control" placeholder="e.g., Senior Software Developer" /><span asp-validation-for="JobTitle" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="TotalOpenings" class="form-label">Total Openings <span class="text-danger">*</span></label><input asp-for="TotalOpenings" class="form-control" type="number" min="1" value="1" /><span asp-validation-for="TotalOpenings" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="DepartmentId" class="form-label">Department <span class="text-danger">*</span></label><select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select"><option value="">-- Select Department --</option></select><small class="text-muted">Department Code: Selected department ka D0001 format</small><span asp-validation-for="DepartmentId" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="ClosingDate" class="form-label">Closing Date</label><input asp-for="ClosingDate" class="form-control" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" /><small class="text-muted">Leave blank if no specific closing date</small><span asp-validation-for="ClosingDate" class="text-danger"></span></div><div class="col-12 mb-3"><label asp-for="JobDescription" class="form-label">Job Description <span class="text-danger">*</span></label><textarea asp-for="JobDescription" class="form-control" rows="6" placeholder="Describe the role, responsibilities, requirements..."></textarea><span asp-validation-for="JobDescription" class="text-danger"></span></div><div class="col-12 mb-3"><label asp-for="RequiredQualifications" class="form-label">Required Qualifications</label><textarea asp-for="RequiredQualifications" class="form-control" rows="4" placeholder="List required skills, experience, education..."></textarea><span asp-validation-for="RequiredQualifications" class="text-danger"></span></div></div><hr /><div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Create Vacancy</button><a href="@Url.Action("Vacancies", "HR")" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Cancel</a></div></form></div></div></div></div>
    <div class="row mt-4"><div class="col-12"><div class="card shadow bg-light"><div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-eye me-2 text-info"></i>Live Preview</h5></div><div class="card-body"><div id="previewContent"><p class="text-muted text-center py-3">Fill the form above to see preview</p></div></div></div></div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>$('#JobTitle, #JobDescription, #RequiredQualifications, #TotalOpenings').on('input',function(){updatePreview();});$('#DepartmentId').on('change',function(){updatePreview();});function updatePreview(){var title=$('#JobTitle').val()||'Job Title';var dept=$('#DepartmentId option:selected').text()||'Department';var openings=$('#TotalOpenings').val()||'0';var desc=$('#JobDescription').val()||'No description provided';var qual=$('#RequiredQualifications').val()||'No qualifications specified';var html=`<div class="card border-primary"><div class="card-header bg-primary text-white"><h5 class="mb-0">${title}</h5><small>${dept} | ${openings} Opening(s)</small></div><div class="card-body"><h6 class="fw-bold">Description:</h6><p>${desc.substring(0,300)}${desc.length>300?'...':''}</p><h6 class="fw-bold mt-3">Qualifications:</h6><p>${qual.substring(0,200)}${qual.length>200?'...':''}</p></div></div>`;$('#previewContent').html(html);}</script>
}