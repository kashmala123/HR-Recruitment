@model HRRecruitment.ViewModels.CreateApplicantViewModel
@{
    ViewData["Title"] = "Create Applicant";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1"><i class="fas fa-user-plus me-2 text-success"></i>Add New Applicant</h4>
                        <p class="text-muted mb-0">Enter applicant details to add to the system</p>
                    </div>
                    <a href="@Url.Action("Applicants", "HR")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Applicants
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="CreateApplicant" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="applicant@email.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">Phone <span class="text-danger">*</span></label>
                                <input asp-for="Phone" class="form-control" placeholder="+92 XXX XXXXXXX" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter full address"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HighestQualification" class="form-label">Highest Qualification</label>
                                <input asp-for="HighestQualification" class="form-control" placeholder="e.g., BS Computer Science" />
                                <span asp-validation-for="HighestQualification" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="ExperienceYears" class="form-label">Experience (Years)</label>
                                <input asp-for="ExperienceYears" class="form-control" type="number" step="0.5" min="0" placeholder="0" />
                                <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="CurrentCompany" class="form-label">Current Company</label>
                                <input asp-for="CurrentCompany" class="form-control" placeholder="Company name" />
                                <span asp-validation-for="CurrentCompany" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Resume" class="form-label">Resume (PDF/DOC)</label>
                                <input asp-for="Resume" class="form-control" type="file" accept=".pdf,.doc,.docx" />
                                <small class="text-muted">Upload resume in PDF or DOC format Max 10MB</small>
                                <span asp-validation-for="Resume" class="text-danger"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Create Applicant
                            </button>
                            <a href="@Url.Action("Applicants", "HR")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
