@model IEnumerable<HRRecruitment.Models.Vacancy>
@{
    ViewData["Title"] = "Vacancies";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}
<div class="container-fluid px-4">
    <div class="row mb-4"><div class="col-12"><div class="card shadow"><div class="card-body d-flex justify-content-between align-items-center"><div><h4 class="mb-1"><i class="fas fa-briefcase me-2 text-primary"></i>Vacancy Management</h4><p class="text-muted mb-0">Manage all your job vacancies</p></div><a href="@Url.Action("CreateVacancy", "HR")" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Create New Vacancy</a></div></div></div></div>
    <div class="row mb-4"><div class="col-12"><div class="card shadow"><div class="card-body"><form method="get" class="row g-3"><div class="col-md-5"><div class="input-group"><span class="input-group-text bg-white"><i class="fas fa-search text-primary"></i></span><input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search by vacancy number or title..."></div></div><div class="col-md-3"><select name="status" class="form-select"><option value="All">All Status</option><option value="Open" selected="@(ViewBag.CurrentStatus == "Open")">Open</option><option value="Closed" selected="@(ViewBag.CurrentStatus == "Closed")">Closed</option><option value="Suspended" selected="@(ViewBag.CurrentStatus == "Suspended")">Suspended</option></select></div><div class="col-md-2"><button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-2"></i>Filter</button></div><div class="col-md-2"><a href="@Url.Action("Vacancies", "HR")" class="btn btn-outline-secondary w-100"><i class="fas fa-redo me-2"></i>Reset</a></div></form></div></div></div></div>
    <div class="row"><div class="col-12"><div class="card shadow"><div class="card-body">@if(Model != null && Model.Any()){<div class="table-responsive"><table class="table table-bordered table-hover"><thead class="table-light"><tr><th>Vacancy #</th><th>Job Title</th><th>Department</th><th>Openings</th><th>Applicants</th><th>Created Date</th><th>Closing Date</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var vacancy in Model){var applicantsCount = vacancy.ApplicantVacancies?.Count ?? 0;<tr><td><strong>@vacancy.VacancyNumber</strong></td><td>@vacancy.JobTitle</td><td>@(vacancy.Department?.DepartmentName ?? "N/A")</td><td><span class="badge bg-info">@vacancy.RemainingOpenings/@vacancy.TotalOpenings</span></td><td><span class="badge bg-secondary">@applicantsCount</span></td><td>@vacancy.CreatedDate.ToString("dd MMM yyyy")</td><td>@if(vacancy.ClosingDate.HasValue){@vacancy.ClosingDate.Value.ToString("dd MMM yyyy") if(vacancy.ClosingDate.Value <= DateTime.Today.AddDays(7) && vacancy.Status == "Open"){<i class="fas fa-exclamation-triangle text-warning ms-2" title="Closing soon!"></i>}}else{<span class="text-muted">-</span>}</td><td>@if(vacancy.Status == "Open"){<span class="badge bg-success">Open</span>}else if(vacancy.Status == "Closed"){<span class="badge bg-secondary">Closed</span>}else{<span class="badge bg-warning">@vacancy.Status</span>}</td><td><div class="btn-group"><a href="@Url.Action("VacancyDetails", "HR", new { id = vacancy.VacancyId })" class="btn btn-sm btn-outline-info" title="View Details"><i class="fas fa-eye"></i></a><a href="@Url.Action("EditVacancy", "HR", new { id = vacancy.VacancyId })" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>@if(vacancy.Status == "Open"){<button type="button" class="btn btn-sm btn-outline-warning" onclick="changeStatus(@vacancy.VacancyId, 'Suspended')" title="Suspend"><i class="fas fa-pause"></i></button><button type="button" class="btn btn-sm btn-outline-danger" onclick="showCloseModal(@vacancy.VacancyId)" title="Close"><i class="fas fa-times"></i></button>}else if(vacancy.Status == "Suspended"){<button type="button" class="btn btn-sm btn-outline-success" onclick="changeStatus(@vacancy.VacancyId, 'Open')" title="Reopen"><i class="fas fa-play"></i></button><button type="button" class="btn btn-sm btn-outline-danger" onclick="showCloseModal(@vacancy.VacancyId)" title="Close"><i class="fas fa-times"></i></button>}</div></td></tr>}</tbody></table></div>}else{<div class="text-center py-5"><i class="fas fa-briefcase fa-4x text-muted mb-3"></i><h5 class="text-muted">No vacancies found</h5><p class="text-muted mb-3">Get started by creating your first vacancy</p><a href="@Url.Action("CreateVacancy", "HR")" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Create New Vacancy</a></div>}</div></div></div></div>
</div>
<div class="modal fade" id="closeVacancyModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Close Vacancy</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="closeVacancyId" /><div class="mb-3"><label class="form-label">Reason for closing</label><textarea class="form-control" id="closeReason" rows="3" placeholder="Enter reason..."></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" onclick="confirmClose()">Close Vacancy</button></div></div></div></div>
@section Scripts {
    <script>function showCloseModal(vacancyId){$('#closeVacancyId').val(vacancyId);$('#closeReason').val('');$('#closeVacancyModal').modal('show');}function changeStatus(vacancyId,status){var message=status=='Open'?'reopen':'suspend';Swal.fire({title:'Are you sure?',text:'Do you want to '+message+' this vacancy?',icon:'warning',showCancelButton:true,confirmButtonColor:status=='Open'?'#28a745':'#ffc107',cancelButtonColor:'#6c757d',confirmButtonText:'Yes, '+message+'!'}).then((result)=>{if(result.isConfirmed){$.ajax({url:'@Url.Action("ChangeVacancyStatus", "HR")',type:'POST',data:{id:vacancyId,status:status},success:function(response){if(response.success){Swal.fire({icon:'success',title:'Success!',text:response.message,timer:2000,showConfirmButton:false}).then(()=>{location.reload();});}else{Swal.fire({icon:'error',title:'Error!',text:response.message});}},error:function(){Swal.fire({icon:'error',title:'Error!',text:'An error occurred'});}});}});}function confirmClose(){var vacancyId=$('#closeVacancyId').val();var reason=$('#closeReason').val();if(!reason){Swal.fire({icon:'warning',title:'Reason Required',text:'Please provide a reason for closing'});return;}$.ajax({url:'@Url.Action("ChangeVacancyStatus", "HR")',type:'POST',data:{id:vacancyId,status:'Closed',reason:reason},success:function(response){if(response.success){$('#closeVacancyModal').modal('hide');Swal.fire({icon:'success',title:'Success!',text:response.message,timer:2000,showConfirmButton:false}).then(()=>{location.reload();});}else{Swal.fire({icon:'error',title:'Error!',text:response.message});}},error:function(){Swal.fire({icon:'error',title:'Error!',text:'An error occurred'});}});}</script>
}