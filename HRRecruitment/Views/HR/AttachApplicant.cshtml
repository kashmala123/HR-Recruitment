@model HRRecruitment.ViewModels.AttachApplicantViewModel
@{
    ViewData["Title"] = "Attach Applicant to Vacancy";
    Layout = "~/Views/Shared/_HRLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1"><i class="fas fa-link me-2 text-primary"></i>Attach Applicant to Vacancy</h4>
                        <p class="text-muted mb-0">Applicant: <strong>@Model.ApplicantName (@Model.ApplicantNumber)</strong></p>
                    </div>
                    <a href="@Url.Action("Applicants", "HR")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Applicants
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="AttachApplicant" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ApplicantId" />
                        <input type="hidden" asp-for="ApplicantName" />
                        <input type="hidden" asp-for="ApplicantNumber" />

                        <div class="text-center mb-4">
                            <i class="fas fa-user-circle fa-4x text-primary"></i>
                            <h5 class="mt-2">@Model.ApplicantName</h5>
                            <p class="text-muted">@Model.ApplicantNumber</p>
                        </div>

                        <div class="mb-4">
                            <label asp-for="VacancyId" class="form-label">Select Vacancy <span class="text-danger">*</span></label>
                            <select asp-for="VacancyId" class="form-select" asp-items="Model.VacanciesList">
                                <option value="">-- Select a vacancy --</option>
                            </select>
                            <span asp-validation-for="VacancyId" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Note:</strong> Only open vacancies with available openings are shown.
                            Attaching will change applicant status to <strong>"In Process"</strong>.
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-link me-2"></i>Attach to Vacancy
                            </button>
                            <a href="@Url.Action("Applicants", "HR")" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}