@{
    ViewData["Title"] = "Unsubscribe Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-5 bg-secondary" style="min-height: 500px;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-6">
                <div class="card bg-dark text-light border-primary shadow-lg wow fadeInUp" data-wow-delay="0.1s">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-envelope-check display-1 text-primary"></i>
                        </div>
                        <div class="title wow fadeInUp" data-wow-delay="0.2s">
                            <div class="title-center">
                                <h5 class="text-primary">Newsletter</h5>
                                <h1 class="text-white">Unsubscribe Confirmation</h1>
                            </div>
                        </div>
                        <div class="alert alert-success mt-4 wow fadeInUp" data-wow-delay="0.3s">
                            @(TempData["UnsubscribeMessage"] ?? "You have been successfully unsubscribed from our newsletter.")
                        </div>
                        <p class="mt-3 text-muted wow fadeInUp" data-wow-delay="0.4s">
                            If this was a mistake, you can <a asp-controller="Home" asp-action="Index" class="text-primary">subscribe again</a>.
                        </p>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary border-2 py-3 px-5 mt-3 wow fadeInUp" data-wow-delay="0.5s">
                            Return to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>