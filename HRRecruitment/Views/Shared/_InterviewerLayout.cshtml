<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Interviewer Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
        :root {
            --theme-black: #0a0a0f;
            --theme-black-lighter: #14141c;
            --theme-dark-pink: #ff2b6e;
            --theme-pink-glow: rgba(255, 43, 110, 0.3);
            --theme-card-bg: #111117;
            --sidebar-width: 270px;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background: #050508; min-height: 100vh; color: #e4e4e7; }
        .sidebar {
            position: fixed; top: 0; left: 0; height: 100%; width: var(--sidebar-width);
            background: linear-gradient(180deg, #0e0e16 0%, #15151f 100%);
            color: white; z-index: 1000; overflow-y: auto;
            border-right: 1px solid rgba(255,43,110,0.15);
        }
        .sidebar-header {
            padding: 24px 20px; text-align: center;
            border-bottom: 1px solid rgba(255,43,110,0.15);
        }
        .sidebar-header img {
            width: 72px; height: 72px; border-radius: 50%;
            border: 2px solid var(--theme-dark-pink); margin-bottom: 12px; object-fit: cover;
        }
        .sidebar-header h4 { font-size: 16px; font-weight: 700; margin-bottom: 4px; color: #fff; }
        .sidebar-header p { font-size: 12px; color: #ffb0c3; margin-bottom: 0; }
        .nav-menu { padding: 16px 0; list-style: none; }
        .nav-item { list-style: none; }
        .nav-link {
            display: flex; align-items: center; padding: 11px 20px;
            color: rgba(255,255,255,0.7); text-decoration: none;
            margin: 4px 12px; border-radius: 10px; transition: all 0.2s;
        }
        .nav-link:hover, .nav-link.active {
            background: rgba(255,43,110,0.15); color: #fff;
        }
        .nav-link.active { border-left: 3px solid var(--theme-dark-pink); }
        .nav-link i { width: 28px; font-size: 16px; color: var(--theme-dark-pink); }
        .nav-link span { font-size: 13.5px; font-weight: 500; }
        .main-content { margin-left: var(--sidebar-width); padding: 24px; min-height: 100vh; }
        .top-navbar {
            background: var(--theme-card-bg);
            padding: 14px 24px; border-radius: 14px;
            border: 1px solid rgba(255,43,110,0.12);
            margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between;
        }
        .page-title h2 { font-size: 22px; font-weight: 700; color: #fff; margin: 0; }
        .user-info { display: flex; align-items: center; gap: 16px; }
        .user-dropdown {
            display: flex; align-items: center; gap: 10px; cursor: pointer;
            padding: 6px 12px; border-radius: 40px;
            background: rgba(30,30,40,0.7); border: 1px solid rgba(255,43,110,0.2);
        }
        .user-dropdown:hover { border-color: var(--theme-dark-pink); }
        .user-dropdown img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
        .user-dropdown .user-text h6 { font-size: 13px; font-weight: 600; margin: 0; color: #fff; }
        .user-dropdown .user-text p { font-size: 11px; color: #9ca3af; margin: 0; }
        .btn-primary {
            background: linear-gradient(95deg, #ff2b6e, #ff4d7a) !important;
            border: none !important; color: white !important;
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(255,43,110,0.35);
        }
        .btn-outline-primary {
            border-color: var(--theme-dark-pink) !important;
            color: var(--theme-dark-pink) !important;
        }
        .btn-outline-primary:hover {
            background: var(--theme-dark-pink) !important; color: #fff !important;
        }
        .card {
            background: var(--theme-card-bg) !important;
            border: 1px solid rgba(255,255,255,0.06) !important;
            border-radius: 16px !important;
            color: #e4e4e7;
        }
        .card-header {
            background: rgba(255,43,110,0.08) !important;
            border-bottom: 1px solid rgba(255,43,110,0.15) !important;
            color: #fff !important;
        }
        .card-header.bg-primary {
            background: linear-gradient(95deg, #ff2b6e, #ff4d7a) !important;
            border: none !important;
        }
        .table { color: #e4e4e7 !important; }
        .table thead th {
            background: rgba(255,43,110,0.1) !important;
            border-color: rgba(255,255,255,0.08) !important;
            color: #ffb0c3 !important;
        }
        .table td, .table th { border-color: rgba(255,255,255,0.06) !important; }
        .table-bordered { border-color: rgba(255,255,255,0.08) !important; }
        .form-control, .form-select {
            background: #0e0e16 !important; border: 1px solid #2a2a35 !important;
            color: #e4e4e7 !important; border-radius: 10px !important;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--theme-dark-pink) !important;
            box-shadow: 0 0 0 2px var(--theme-pink-glow) !important;
            background: #0e0e16 !important; color: #fff !important;
        }
        .alert-success { background: rgba(46,204,113,0.15); border-color: rgba(46,204,113,0.3); color: #2ecc71; }
        .alert-danger { background: rgba(255,43,110,0.15); border-color: rgba(255,43,110,0.3); color: #ff6b8a; }
        .alert-info { background: rgba(74,144,226,0.15); border-color: rgba(74,144,226,0.3); color: #7eb6ff; }
        .badge.bg-success { background: #2ecc71 !important; }
        .badge.bg-info { background: var(--theme-dark-pink) !important; }
        .badge.bg-primary { background: var(--theme-dark-pink) !important; }
        .badge.bg-warning { background: #f39c12 !important; color: #111 !important; }
        .spinner-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5,5,8,0.7); display: none; justify-content: center; align-items: center; z-index: 9999;
        }
        .spinner {
            width: 48px; height: 48px; border: 4px solid #2a2a35;
            border-top: 4px solid var(--theme-dark-pink); border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .text-muted { color: #9ca3af !important; }
        .text-primary { color: var(--theme-dark-pink) !important; }
        h1,h2,h3,h4,h5,h6 { color: #fff; }
        a { color: var(--theme-dark-pink); }
        .bg-white, .bg-light { background: var(--theme-card-bg) !important; }
        .shadow, .shadow-sm { box-shadow: 0 8px 24px rgba(0,0,0,0.35) !important; }
    </style>

</head>
<body>
    <div class="spinner-overlay" id="loadingSpinner"><div class="spinner"></div></div>
    <div class="sidebar">
        <div class="sidebar-header">
            <img src="@(ViewBag.Interviewer?.ProfilePicture ?? $"https://ui-avatars.com/api/?name={ViewBag.Interviewer?.EmployeeName ?? "Interviewer"}&size=80&background=1e2b4f&color=fff")" alt="Profile">
            <h4>@(ViewBag.Interviewer?.EmployeeName ?? "Interviewer")</h4>
            <p>@(ViewBag.Interviewer?.EmployeeNumber ?? "INT001")</p>
            <p style="font-size:12px; background:rgba(255,255,255,0.2); padding:3px 10px; border-radius:20px; display:inline-block;">
                <i class="fas fa-building me-1"></i>@(ViewBag.Interviewer?.Department?.DepartmentName ?? "Interview Panel")
            </p>
        </div>
        <ul class="nav-menu">
            <li><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "MyInterviews" ? "active" : "")" href="@Url.Action("MyInterviews", "Interviewer")"><i class="fas fa-calendar-check"></i><span>My Interviews</span>@if(ViewBag.TodayInterviewsCount>0){
            <span class="badge">@ViewBag.TodayInterviewsCount</span>
                        }
</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CompletedInterviews" ? "active" : "")" href="@Url.Action("CompletedInterviews", "Interviewer")"><i class="fas fa-history"></i><span>Completed</span></a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Vacancies" ? "active" : "")" href="@Url.Action("Vacancies", "Interviewer")"><i class="fas fa-briefcase"></i><span>Vacancies</span></a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Applicants" ? "active" : "")" href="@Url.Action("Applicants", "Interviewer")"><i class="fas fa-users"></i><span>Applicants</span></a></li>
            <li style="margin-top:30px;"><a class="nav-link" href="@Url.Action("Profile", "Account")"><i class="fas fa-user"></i><span>My Profile</span></a></li>
            <li><a class="nav-link" href="@Url.Action("ChangePassword", "Account")"><i class="fas fa-key"></i><span>Change Password</span></a></li>
            <li><a class="nav-link" href="@Url.Action("Logout", "Account")" style="color:#ff6b6b;"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
        </ul>
    </div>
    <div class="main-content">
        <div class="top-navbar">
            <div class="page-title"><h2>@ViewData["Title"]</h2></div>
            <div class="user-info d-flex align-items-center gap-3">
                <div class="position-relative">
                    <button type="button" id="ivNotifBtn" style="background:none;border:none;color:#a0a0b0;cursor:pointer;position:relative;padding:6px;">
                        <i class="far fa-bell fs-5"></i>
                        <span id="ivNotifBadge" style="display:none;position:absolute;top:0;right:0;background:#ff2b6e;color:#fff;font-size:10px;font-weight:700;min-width:16px;height:16px;border-radius:50%;align-items:center;justify-content:center;"></span>
                    </button>
                    <div id="ivNotifPanel" style="display:none;position:absolute;right:0;top:calc(100% + 10px);width:320px;max-height:380px;overflow-y:auto;background:#1a1a24;border:1px solid rgba(255,255,255,0.1);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.4);z-index:1050;">
                        <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.08);font-weight:600;color:#fff;"><i class="far fa-bell me-2"></i>Notifications</div>
                        <div id="ivNotifList"><div style="padding:24px;text-align:center;color:#6b7280;">Loading...</div></div>
                    </div>
                </div>
                <div class="position-relative">
                    <div class="user-dropdown" id="ivProfileBtn" style="cursor:pointer;">
                        <img src="@(ViewBag.Interviewer?.ProfilePicture ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(ViewBag.Interviewer?.EmployeeName ?? "Interviewer")}&size=40&background=1e2b4f&color=fff")" alt="User">
                        <div class="user-text">
                            <h6>@(ViewBag.Interviewer?.EmployeeName ?? "Interviewer")</h6>
                            <p><i class="fas fa-circle" style="color:#2ecc71; font-size:8px;"></i> Online</p>
                        </div>
                    </div>
                    <div id="ivProfilePanel" style="display:none;position:absolute;right:0;top:calc(100% + 10px);width:220px;background:#1a1a24;border:1px solid rgba(255,255,255,0.1);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,0.4);z-index:1050;overflow:hidden;">
                        <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.08);font-weight:600;color:#fff;font-size:0.9rem;">@(ViewBag.Interviewer?.EmployeeName ?? "Interviewer")</div>
                        <a href="@Url.Action("Profile", "Account")" style="display:flex;align-items:center;gap:10px;padding:11px 16px;color:#e4e4e7;text-decoration:none;font-size:0.875rem;"><i class="fas fa-user"></i> My Profile</a>
                        <a href="@Url.Action("ChangePassword", "Account")" style="display:flex;align-items:center;gap:10px;padding:11px 16px;color:#e4e4e7;text-decoration:none;font-size:0.875rem;"><i class="fas fa-key"></i> Change Password</a>
                        <a href="@Url.Action("MyInterviews", "Interviewer")" style="display:flex;align-items:center;gap:10px;padding:11px 16px;color:#e4e4e7;text-decoration:none;font-size:0.875rem;"><i class="fas fa-calendar"></i> My Interviews</a>
                        <div style="height:1px;background:rgba(255,255,255,0.08);"></div>
                        <a href="@Url.Action("Logout", "Account")" style="display:flex;align-items:center;gap:10px;padding:11px 16px;color:#ff6b6b;text-decoration:none;font-size:0.875rem;"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-fluid px-0">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ajaxStart(function(){$('#loadingSpinner').css('display','flex');});
        $(document).ajaxStop(function(){$('#loadingSpinner').css('display','none');});
        setTimeout(function(){$('.alert').fadeOut('slow');},5000);
        function confirmAction(msg,cb){Swal.fire({title:'Are you sure?',text:msg,icon:'warning',showCancelButton:true,confirmButtonColor:'#1e2b4f',cancelButtonColor:'#d33'}).then(r=>{if(r.isConfirmed)cb();});}
        function showSuccess(msg){Swal.fire({icon:'success',title:'Success!',text:msg,timer:3000,showConfirmButton:false});}
        function showError(msg){Swal.fire({icon:'error',title:'Error!',text:msg});}

        (function(){
            const notifBtn=document.getElementById('ivNotifBtn');
            const notifPanel=document.getElementById('ivNotifPanel');
            const profileBtn=document.getElementById('ivProfileBtn');
            const profilePanel=document.getElementById('ivProfilePanel');
            const notifList=document.getElementById('ivNotifList');
            const notifBadge=document.getElementById('ivNotifBadge');
            function closeAll(){if(notifPanel)notifPanel.style.display='none';if(profilePanel)profilePanel.style.display='none';}
            notifBtn&&notifBtn.addEventListener('click',function(e){e.stopPropagation();const open=notifPanel.style.display==='block';closeAll();if(!open){notifPanel.style.display='block';loadNotifs();}});
            profileBtn&&profileBtn.addEventListener('click',function(e){e.stopPropagation();const open=profilePanel.style.display==='block';closeAll();if(!open)profilePanel.style.display='block';});
            document.addEventListener('click',closeAll);
            notifPanel&&notifPanel.addEventListener('click',e=>e.stopPropagation());
            profilePanel&&profilePanel.addEventListener('click',e=>e.stopPropagation());
            function esc(s){const d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
            function loadNotifs(){fetch('@Url.Action("GetNotifications","Account")').then(r=>r.json()).then(data=>{const items=data.items||[];if(!items.length){notifList.innerHTML='<div style="padding:24px;text-align:center;color:#6b7280;">No notifications yet</div>';notifBadge.style.display='none';return;}notifBadge.textContent=items.length>9?'9+':items.length;notifBadge.style.display='flex';notifList.innerHTML=items.map(n=>`<div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.05);display:flex;gap:12px;"><i class="fas ${n.icon||'fa-info-circle'}" style="color:#4a90e2;margin-top:3px;"></i><div><div style="font-size:0.85rem;font-weight:600;color:#fff;">${esc(n.title)}</div><div style="font-size:0.75rem;color:#9ca3af;">${esc(n.message)}</div><div style="font-size:0.7rem;color:#6b7280;">${esc(n.time)}</div></div></div>`).join('');}).catch(()=>{notifList.innerHTML='<div style="padding:24px;text-align:center;color:#6b7280;">Could not load</div>';});}
            fetch('@Url.Action("GetNotifications","Account")').then(r=>r.json()).then(data=>{const c=(data.items||[]).length;if(c>0){notifBadge.textContent=c>9?'9+':c;notifBadge.style.display='flex';}}).catch(()=>{});
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>