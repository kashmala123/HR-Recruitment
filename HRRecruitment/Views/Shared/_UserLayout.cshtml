<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>@ViewBag.Title - HR Recruitment</title>
    
    <!-- Favicon (use your own if available) -->
    <link rel="icon" href="~/img/download.png" type="image/png">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    
    <style>
        /* ========== GLOBAL BLACK & PINK THEME ========== */
        :root {
            --theme-black: #0a0a0f;
            --theme-black-hover: #1a1a24;
            --theme-dark-pink: #ff2b6e;
            --theme-pink-glow: rgba(255, 43, 110, 0.3);
            --theme-card-bg: #111117;
            --theme-border-subtle: #2a2a33;
            --sidebar-width: 270px;
            --nav-height: 64px;
        }

        body {
            background: radial-gradient(circle at 10% 20%, rgba(10,10,15,0.98) 0%, #050508 100%);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            margin: 0;
            color: #e4e4e7;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1a1a24; }
        ::-webkit-scrollbar-thumb { background: #2f2f3a; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--theme-dark-pink); }

        /* ========== SIDEBAR ========== */
        .sidebar {
            height: 100vh;
            width: var(--sidebar-width);
            position: fixed;
            top: 0;
            left: 0;
            background: rgba(10, 10, 15, 0.95);
            backdrop-filter: blur(8px);
            border-right: 1px solid rgba(255,43,110,0.2);
            z-index: 1000;
            transition: all 0.3s;
        }

        .sidebar-content {
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: 0 16px 24px;
        }

        .brand-logo {
            padding: 28px 0 20px 0;
            border-bottom: 1px solid rgba(255,43,110,0.3);
            margin-bottom: 16px;
            text-align: center;
        }

        .brand-logo img {
            height: 50px;
            width: auto;
            filter: brightness(0) invert(1);
        }

        .brand-logo h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-top: 0.5rem;
            background: linear-gradient(135deg, #fff, #ffb0c3);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
        }

        .nav-section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #9ca3af;
            margin: 20px 0 10px 12px;
            font-weight: 700;
        }

        .sidebar a {
            padding: 12px 14px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            color: #b0b0c0;
            display: flex;
            align-items: center;
            border-radius: 12px;
            margin-bottom: 6px;
            transition: all 0.2s;
        }

        .sidebar a i {
            margin-right: 12px;
            font-size: 18px;
            width: 24px;
            text-align: center;
        }

        .sidebar a:hover {
            color: white;
            background: var(--theme-black-hover);
        }

        .sidebar a.active {
            background: linear-gradient(95deg, var(--theme-dark-pink), #ff4d7a);
            color: white;
            box-shadow: 0 4px 12px rgba(255,43,110,0.3);
        }

        .sidebar a.active i {
            color: white;
        }

        .logout-btn {
            margin-top: auto;
            color: #ff7b9c !important;
            border: 1px solid rgba(255,43,110,0.3);
        }

        .logout-btn:hover {
            background: rgba(255,43,110,0.1) !important;
            color: #ff9bb5 !important;
        }

        /* ========== MAIN CONTENT AREA ========== */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navbar - Compact & Aligned */
        .top-navbar {
            height: var(--nav-height);
            background: rgba(10, 10, 15, 0.7);
            backdrop-filter: blur(12px);
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            border-bottom: 1px solid rgba(255,43,110,0.2);
        }

        .breadcrumb-text {
            font-size: 13px;
            color: #b0b0c0;
        }

        .breadcrumb-item-active {
            color: var(--theme-dark-pink);
            font-weight: 600;
        }

        .user-profile-nav {
            display: flex;
            align-items: center;
            padding: 5px 16px;
            border-radius: 40px;
            background: rgba(30, 30, 40, 0.7);
            border: 1px solid rgba(255,43,110,0.2);
            backdrop-filter: blur(4px);
        }

        .user-profile-nav .text-end div {
            font-weight: 700;
            font-size: 13px;
            line-height: 1.2;
            color: white;
        }

        .user-profile-nav .text-end small {
            color: #ffb0c3 !important;
            font-size: 11px;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
            box-shadow: 0 2px 8px rgba(255,43,110,0.3);
            overflow: hidden;
            background: linear-gradient(145deg, var(--theme-dark-pink), #ff4d7a);
            color: white;
        }

        .notification-icon, .profile-dropdown-toggle {
            color: #b0b0c0;
            cursor: pointer;
            transition: color 0.2s;
            position: relative;
            background: none;
            border: none;
            padding: 6px;
        }

        .notification-icon:hover, .profile-dropdown-toggle:hover {
            color: var(--theme-dark-pink);
        }

        .notif-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: #ff2b6e;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .dropdown-panel {
            position: absolute;
            right: 0;
            top: calc(100% + 10px);
            width: 320px;
            max-height: 380px;
            overflow-y: auto;
            background: #1a1a24;
            border: 1px solid rgba(255,43,110,0.25);
            border-radius: 14px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.5);
            z-index: 1050;
            display: none;
        }

        .dropdown-panel.show { display: block; }

        .dropdown-panel-header {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            font-weight: 600;
            font-size: 0.9rem;
            color: #fff;
        }

        .notif-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            display: flex;
            gap: 12px;
            align-items: flex-start;
            transition: background 0.15s;
        }
        .notif-item:hover { background: rgba(255,43,110,0.08); }
        .notif-item i { color: #ff2b6e; margin-top: 3px; }
        .notif-item .notif-title { font-size: 0.85rem; font-weight: 600; color: #fff; }
        .notif-item .notif-msg { font-size: 0.75rem; color: #9ca3af; margin: 2px 0; }
        .notif-item .notif-time { font-size: 0.7rem; color: #6b7280; }
        .notif-empty { padding: 24px; text-align: center; color: #6b7280; font-size: 0.85rem; }

        .profile-menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            color: #e4e4e7;
            text-decoration: none;
            font-size: 0.875rem;
            transition: background 0.15s;
        }
        .profile-menu-item:hover { background: rgba(255,43,110,0.1); color: #ff2b6e; }
        .profile-menu-item.danger { color: #ff6b6b; }
        .profile-menu-item.danger:hover { background: rgba(255,107,107,0.1); color: #ff6b6b; }
        .profile-menu-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 4px 0; }

        .user-profile-nav { cursor: pointer; position: relative; }

        /* Content Area - Clean, centered padding */
        .content-wrapper {
            padding: 2rem;
            flex: 1;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
        }

        /* Footer */
        footer {
            background: rgba(10, 10, 15, 0.8);
            backdrop-filter: blur(8px);
            border-top: 1px solid rgba(255,43,110,0.1);
            color: #9ca3af;
            font-size: 0.8rem;
            text-align: center;
            padding: 0.75rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s;
            }
            .sidebar.open {
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
            }
            .content-wrapper {
                padding: 1rem;
            }
            .top-navbar {
                padding: 0 1rem;
            }
            .user-profile-nav .text-end {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- 1. LEFT SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-content">
            
            <!-- BRAND LOGO -->
            <div class="brand-logo">
                <img src="~/img/download.png" alt="HR Recruitment">
                <h3>HR Recruitment</h3>
            </div>
            
            <div class="nav-section-title">Main Menu</div>
            <a href="@Url.Action("Index", "UserPanel")" class="@(ViewBag.Title == "Dashboard" ? "active" : "")">
                <i class="fas fa-th-large"></i> Dashboard
            </a>

            <a href="@Url.Action("Vacancies", "UserPanel")" class="@(ViewBag.Title == "Available Vacancies" ? "active" : "")">
                <i class="fas fa-briefcase"></i> Vacancies
            </a>
            
            <a href="@Url.Action("MyApplications", "UserPanel")" class="@(ViewBag.Title == "Scheduled Interviews" ? "active" : "")">
                <i class="fas fa-calendar-check"></i> My Applications
            </a>

            <div class="nav-section-title">Account Settings</div>
            <a href="@Url.Action("MyProfile", "UserPanel")" class="@(ViewBag.Title == "Account Profile" ? "active" : "")">
                <i class="fas fa-user-circle"></i> My Profile
            </a>
            <a href="@Url.Action("ChangePassword", "UserPanel")" class="@(ViewBag.Title == "Security Settings" ? "active" : "")">
                <i class="fas fa-shield-alt"></i> Security
            </a>
            <a href="@Url.Action("Help", "UserPanel")" class="@(ViewBag.Title == "System Help & FAQ" ? "active" : "")">
                <i class="fas fa-question-circle"></i> Support Help
            </a>
            
            <!-- Logout -->
            <a href="@Url.Action("Logout", "Account")" class="logout-btn">
                <i class="fas fa-power-off"></i> Sign Out
            </a>
        </div>
    </div>

    <!-- 2. MAIN CONTENT -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="d-none d-md-block">
                <div class="breadcrumb-text">
                    Pages / <span class="breadcrumb-item-active">@ViewBag.Title</span>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <!-- Notifications -->
                <div class="position-relative">
                    <button type="button" class="notification-icon" id="notifBtn" aria-label="Notifications">
                        <i class="far fa-bell fs-5"></i>
                        <span class="notif-badge" id="notifBadge">0</span>
                    </button>
                    <div class="dropdown-panel" id="notifPanel">
                        <div class="dropdown-panel-header"><i class="far fa-bell me-2"></i>Notifications</div>
                        <div id="notifList"><div class="notif-empty">Loading...</div></div>
                    </div>
                </div>

                <!-- Profile dropdown -->
                <div class="user-profile-nav position-relative" id="profileBtn">
                    <div class="text-end me-3 d-none d-sm-block">
                        <div>@User.Identity.Name</div>
                        <small>Applicant</small>
                    </div>
                    <div class="user-avatar" style="overflow:hidden; padding:0;">
                        @{
                            var pic = User.Claims.FirstOrDefault(c => c.Type == "ProfilePicture")?.Value;
                            var userName = User.Identity.Name ?? "U";
                            var firstLetter = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
                        }
                        @if (!string.IsNullOrEmpty(pic))
                        {
                            <img src="@pic" alt="Avatar" style="width:100%; height:100%; object-fit:cover;" />
                        }
                        else
                        {
                            <span>@firstLetter</span>
                        }
                    </div>
                    <div class="dropdown-panel" id="profilePanel" style="width:220px;">
                        <div class="dropdown-panel-header">@User.Identity.Name</div>
                        <a class="profile-menu-item" href="@Url.Action("MyProfile", "UserPanel")"><i class="fas fa-user"></i> My Profile</a>
                        <a class="profile-menu-item" href="@Url.Action("ChangePassword", "UserPanel")"><i class="fas fa-shield-alt"></i> Security</a>
                        <a class="profile-menu-item" href="@Url.Action("Help", "UserPanel")"><i class="fas fa-question-circle"></i> Help</a>
                        <div class="profile-menu-divider"></div>
                        <a class="profile-menu-item danger" href="@Url.Action("Logout", "Account")"><i class="fas fa-power-off"></i> Sign Out</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. PAGE SPECIFIC CONTENT -->
        <div class="content-wrapper">
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer>
            &copy; @DateTime.Now.Year -  Company Recruitment System. Designed for HR Recruitment.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const notifBtn = document.getElementById('notifBtn');
            const notifPanel = document.getElementById('notifPanel');
            const profileBtn = document.getElementById('profileBtn');
            const profilePanel = document.getElementById('profilePanel');
            const notifList = document.getElementById('notifList');
            const notifBadge = document.getElementById('notifBadge');

            function closeAll() {
                notifPanel?.classList.remove('show');
                profilePanel?.classList.remove('show');
            }

            notifBtn?.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = notifPanel.classList.contains('show');
                closeAll();
                if (!open) {
                    notifPanel.classList.add('show');
                    loadNotifications();
                }
            });

            profileBtn?.addEventListener('click', function (e) {
                e.stopPropagation();
                const open = profilePanel.classList.contains('show');
                closeAll();
                if (!open) profilePanel.classList.add('show');
            });

            document.addEventListener('click', closeAll);
            notifPanel?.addEventListener('click', e => e.stopPropagation());
            profilePanel?.addEventListener('click', e => e.stopPropagation());

            function loadNotifications() {
                fetch('@Url.Action("GetNotifications", "Account")')
                    .then(r => r.json())
                    .then(data => {
                        const items = data.items || [];
                        if (items.length === 0) {
                            notifList.innerHTML = '<div class="notif-empty"><i class="far fa-bell-slash mb-2 d-block"></i>No notifications yet</div>';
                            notifBadge.style.display = 'none';
                            return;
                        }
                        notifBadge.textContent = items.length > 9 ? '9+' : items.length;
                        notifBadge.style.display = 'flex';
                        notifList.innerHTML = items.map(n => `
                            <div class="notif-item">
                                <i class="fas ${n.icon || 'fa-info-circle'}"></i>
                                <div>
                                    <div class="notif-title">${escapeHtml(n.title)}</div>
                                    <div class="notif-msg">${escapeHtml(n.message)}</div>
                                    <div class="notif-time">${escapeHtml(n.time)}</div>
                                </div>
                            </div>`).join('');
                    })
                    .catch(() => {
                        notifList.innerHTML = '<div class="notif-empty">Could not load notifications</div>';
                    });
            }

            function escapeHtml(s) {
                const d = document.createElement('div');
                d.textContent = s || '';
                return d.innerHTML;
            }

            // Preload badge count
            fetch('@Url.Action("GetNotifications", "Account")')
                .then(r => r.json())
                .then(data => {
                    const c = (data.items || []).length;
                    if (c > 0) {
                        notifBadge.textContent = c > 9 ? '9+' : c;
                        notifBadge.style.display = 'flex';
                    }
                }).catch(() => {});
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>