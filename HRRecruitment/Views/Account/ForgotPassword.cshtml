@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - HR Recruitment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background: #050508;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .card-box {
            background: #111117;
            border-radius: 24px;
            padding: 2rem;
            width: 100%;
            max-width: 420px;
            border: 1px solid rgba(255, 43, 110, 0.2);
            box-shadow: 0 20px 35px -10px rgba(0,0,0,0.5);
        }
        .form-control {
            background-color: #0e0e16;
            border: 1px solid #2a2a35;
            color: #e4e4e7;
            border-radius: 12px;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            background-color: #0e0e16;
            border-color: #ff2b6e;
            box-shadow: 0 0 0 2px rgba(255,43,110,0.3);
            color: #fff;
        }
        .btn-pink {
            background: linear-gradient(95deg, #ff2b6e, #ff4d7a);
            border: none;
            color: white;
            font-weight: 600;
            border-radius: 40px;
            padding: 0.75rem;
        }
        label { font-weight: 600; font-size: 0.85rem; color: #b0b0c0; }
        a { color: #ff2b6e; text-decoration: none; }
        h3 {
            background: linear-gradient(135deg, #fff, #ffb0c3);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="card-box">
        <div class="text-center mb-4">
            <h3>Forgot Password</h3>
            <p class="text-muted">Enter your account email and we'll send a temporary password.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post" asp-action="ForgotPassword">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Email address</label>
                <input type="email" name="email" class="form-control" placeholder="you@example.com" required />
            </div>
            <button type="submit" class="btn btn-pink w-100">Send Temporary Password</button>
            <div class="text-center mt-3">
                <a asp-action="Login">Back to Login</a>
            </div>
        </form>
    </div>
</body>
</html>
