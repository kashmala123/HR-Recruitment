@model HRRecruitment.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    if (User.IsInRole("HR"))
    {
        Layout = "~/Views/Shared/_HRLayout.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
    }
}
<div class="container-fluid px-4">
    <div class="row mb-4"><div class="col-12"><div class="card shadow"><div class="card-body"><h4 class="mb-1"><i class="fas fa-key me-2 text-warning"></i>Change Password</h4><p class="text-muted mb-0">Update your account password</p></div></div></div></div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    <div class="row"><div class="col-md-8 mx-auto"><div class="card shadow"><div class="card-header bg-warning text-white"><h5 class="mb-0"><i class="fas fa-lock me-2"></i>Change Password Form</h5></div><div class="card-body"><form asp-action="ChangePassword" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-group mb-3"><label asp-for="CurrentPassword" class="form-label">Current Password <span class="text-danger">*</span></label><div class="input-group"><span class="input-group-text bg-white"><i class="fas fa-lock text-warning"></i></span><input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter current password" /></div><span asp-validation-for="CurrentPassword" class="text-danger"></span></div><div class="form-group mb-3"><label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label><div class="input-group"><span class="input-group-text bg-white"><i class="fas fa-key text-success"></i></span><input asp-for="NewPassword" class="form-control" type="password" placeholder="Enter new password" /></div><small class="text-muted">Password must be at least 6 characters long</small><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="form-group mb-4"><label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label><div class="input-group"><span class="input-group-text bg-white"><i class="fas fa-check-circle text-success"></i></span><input asp-for="ConfirmNewPassword" class="form-control" type="password" placeholder="Re-enter new password" /></div><span asp-validation-for="ConfirmNewPassword" class="text-danger"></span></div><div class="alert alert-info"><h6 class="alert-heading"><i class="fas fa-info-circle me-2"></i>Password Requirements:</h6><ul class="mb-0 small"><li>Minimum 6 characters long</li><li>At least one uppercase letter (A-Z)</li><li>At least one lowercase letter (a-z)</li><li>At least one number (0-9)</li><li>At least one special character (!&#64;#$%^&*)</li></ul></div><hr /><div class="d-flex gap-2"><button type="submit" class="btn btn-warning"><i class="fas fa-save me-2"></i>Update Password</button>@if(User.IsInRole("HR")){
    <a href="@Url.Action("Dashboard", "HR")" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Cancel</a>
        }else
    {

        <a href="@Url.Action("MyInterviews", "Interviewer")" class="btn btn-secondary"><i class="fas fa-times me-2"></i>Cancel</a>
    }
</div></form></div></div></div></div>
    <div class="row mt-4"><div class="col-md-8 mx-auto"><div class="card shadow bg-light"><div class="card-body"><h5><i class="fas fa-shield-alt me-2 text-primary"></i>Security Tips</h5><ul class="mb-0"><li>Never share your password with anyone</li><li>Use different passwords for different accounts</li><li>Change your password regularly</li><li>Make sure you're on the official website before entering your password</li></ul></div></div></div></div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}