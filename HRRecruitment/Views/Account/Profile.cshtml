@model HRRecruitment.Models.Employee
@{
    ViewData["Title"] = "My Profile";
    if (User.IsInRole("HR"))
    {
        Layout = "~/Views/Shared/_HRLayout.cshtml";
        ViewBag.HR = Model;
    }
    else
    {
        Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
        ViewBag.Interviewer = Model;
    }
    var avatarUrl = !string.IsNullOrEmpty(Model.ProfilePicture) && Model.ProfilePicture != "/images/default-avatar.png"
        ? Model.ProfilePicture
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.EmployeeName ?? "User")}&size=150&background=1e2b4f&color=fff&bold=true";
}
<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1"><i class="fas fa-user-circle me-2 text-primary"></i>My Profile</h4>
                    <p class="text-muted mb-0">View and update your personal information</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow text-center">
                <div class="card-body">
                    <img id="avatarPreview" src="@avatarUrl"
                         class="rounded-circle img-fluid mb-3"
                         style="width:150px;height:150px;object-fit:cover;"
                         alt="@Model.EmployeeName">
                    <h5 class="mt-2">@Model.EmployeeName</h5>
                    <p class="text-muted mb-1">@Model.Role</p>
                    <span class="badge bg-success">@(Model.IsActive ? "Active" : "Inactive")</span>
                    @if (Model.LastLoginDate.HasValue)
                    {
                        <p class="text-muted small mt-2 mb-0">
                            <i class="fas fa-clock me-1"></i>
                            Last login: @Model.LastLoginDate.Value.ToString("dd MMM yyyy HH:mm")
                        </p>
                    }

                    <form asp-action="UploadProfilePicture" asp-controller="Account" method="post" enctype="multipart/form-data" class="mt-3">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <input type="file" name="profileImage" id="profileImage" class="form-control form-control-sm" accept="image/*,.jpg,.jpeg,.png,.gif,.webp,.jfif,.bmp" onchange="previewAvatar(this)" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fas fa-camera me-1"></i> Upload Picture
                        </button>
                        <small class="d-block text-muted mt-1">JPG, PNG, GIF, WEBP or BMP. Max 5 MB.</small>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Personal Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width:200px">Employee Number</th>
                            <td><strong>@Model.EmployeeNumber</strong></td>
                        </tr>
                        <tr>
                            <th>Full Name</th>
                            <td>@Model.EmployeeName</td>
                        </tr>
                        <tr>
                            <th>Email Address</th>
                            <td><i class="fas fa-envelope me-1 text-muted"></i> @Model.Email</td>
                        </tr>
                        <tr>
                            <th>Department</th>
                            <td><i class="fas fa-building me-1 text-muted"></i> @(Model.Department?.DepartmentName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Role</th>
                            <td><span class="badge bg-info">@Model.Role</span></td>
                        </tr>
                        <tr>
                            <th>Account Status</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Member Since</th>
                            <td><i class="fas fa-calendar me-1 text-muted"></i> @Model.CreatedDate.ToString("dd MMMM yyyy")</td>
                        </tr>
                    </table>
                    <div class="mt-4 d-flex gap-2">
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-warning">
                            <i class="fas fa-key me-2"></i>Change Password
                        </a>
                        @if (User.IsInRole("HR"))
                        {
                            <a href="@Url.Action("Dashboard", "HR")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("MyInterviews", "Interviewer")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function previewAvatar(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('avatarPreview').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
