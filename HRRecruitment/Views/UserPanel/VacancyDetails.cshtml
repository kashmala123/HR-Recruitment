@model HRRecruitment.Models.Vacancy
@{
    ViewBag.Title = "Vacancy Details";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-4">
            <h2 class="mb-0">@Model.JobTitle</h2>
            <p class="text-muted mb-0">@Model.VacancyNumber</p>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5><i class="fas fa-building me-2 text-pink"></i> Department</h5>
                    <p>@(Model.Department?.DepartmentName ?? "Not specified")</p>
                </div>
                <div class="col-md-6">
                    <h5><i class="fas fa-users me-2 text-pink"></i> Openings</h5>
                    <p>@Model.TotalOpenings</p>
                </div>
            </div>

            <h5><i class="fas fa-file-alt me-2 text-pink"></i> Job Description</h5>
            <p class="mb-4">@Model.JobDescription</p>

            <h5><i class="fas fa-graduation-cap me-2 text-pink"></i> Required Qualifications</h5>
            <p class="mb-4">@(Model.RequiredQualifications ?? "Not specified")</p>

            @if (Model.ClosingDate.HasValue)
            {
                <div class="alert alert-warning mt-3">
                    <i class="fas fa-calendar-alt me-2"></i> Closing date: @Model.ClosingDate.Value.ToString("dd MMM yyyy")
                </div>
            }

            <div class="text-center mt-4">
                <form asp-action="Apply" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="vacancyId" value="@Model.VacancyId" />
                    <button type="submit" class="btn btn-primary btn-lg px-5">Apply Now</button>
                </form>
                <a href="@Url.Action("Vacancies")" class="btn btn-outline-secondary btn-lg ms-3">Back to List</a>
            </div>
        </div>
    </div>
</div>

<style>
    .text-pink {
        color: #ff2b6e;
    }
</style>