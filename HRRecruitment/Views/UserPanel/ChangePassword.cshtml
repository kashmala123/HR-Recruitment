@model HRRecruitment.Models.ChangePasswordVM
@{
    ViewBag.Title = "Security Settings";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    /* ========== COMPACT BLACK & PINK SECURITY CARD ========== */
    :root {
        --theme-black: #0a0a0f;
        --theme-black-lighter: #14141c;
        --theme-dark-pink: #ff2b6e;
        --theme-pink-glow: rgba(255, 43, 110, 0.3);
        --theme-card-bg: #111117;
    }

    /* Override content-wrapper to center the card vertically */
    .content-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 64px - 48px); /* subtract navbar + footer approximate heights */
        padding: 1rem;
    }

    .security-card {
        border: none;
        border-radius: 24px;
        background: var(--theme-card-bg);
        box-shadow: 0 20px 35px -10px rgba(0,0,0,0.5);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        margin: 0 auto;
    }

    .security-header {
        background: linear-gradient(125deg, #0a0a0f 0%, #1a1a24 100%);
        padding: 20px 20px 16px;
        text-align: center;
        border-bottom: 1px solid rgba(255,43,110,0.3);
    }

    .security-icon-circle {
        width: 56px;
        height: 56px;
        background: linear-gradient(145deg, var(--theme-dark-pink), #e21c5c);
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 10px;
        box-shadow: 0 4px 12px rgba(255,43,110,0.3);
    }

    .security-header h4 {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0 0 4px;
        background: linear-gradient(135deg, #fff, #ffb0c3);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
    }

    .security-header p {
        font-size: 0.8rem;
        opacity: 0.7;
        margin: 0;
    }

    .card-body {
        padding: 1.5rem 1.8rem 1.8rem;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #e0e0e6;
        margin-bottom: 0.3rem;
    }

    .input-group {
        border-radius: 12px;
        overflow: hidden;
        background: #0e0e16;
        border: 1px solid #2a2a35;
        transition: 0.2s;
    }

    .input-group:focus-within {
        border-color: var(--theme-dark-pink);
        box-shadow: 0 0 0 2px var(--theme-pink-glow);
    }

    .input-group-text {
        background: #13131b;
        border: none;
        color: #b0b0c0;
        cursor: pointer;
        padding: 0 12px;
        font-size: 0.9rem;
    }

    .input-group-text:hover {
        color: var(--theme-dark-pink);
    }

    .form-control {
        background: #0e0e16;
        border: none;
        color: white;
        padding: 8px 12px;
        font-size: 0.9rem;
    }

    .form-control:focus {
        background: #0e0e16;
        box-shadow: none;
        color: white;
    }

    .form-control::placeholder {
        color: #6c6c7a;
        font-size: 0.85rem;
    }

    .password-requirement {
        font-size: 0.7rem;
        color: #9ca3af;
        margin-top: 4px;
        margin-left: 5px;
    }

    .btn-update {
        background: linear-gradient(95deg, var(--theme-dark-pink), #ff4d7a);
        color: white;
        border: none;
        padding: 10px;
        border-radius: 40px;
        font-weight: 600;
        width: 100%;
        transition: all 0.2s;
        margin-top: 0.5rem;
        font-size: 0.9rem;
    }

    .btn-update:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 12px rgba(255,43,110,0.3);
    }

    hr {
        background: linear-gradient(90deg, transparent, var(--theme-dark-pink), transparent);
        height: 1px;
        margin: 1rem 0;
    }

    .alert-success {
        background: rgba(255,43,110,0.12);
        border: 1px solid rgba(255,43,110,0.3);
        color: #ffb7cc;
        border-radius: 40px;
        padding: 8px 15px;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .text-danger {
        color: #ff7b9c !important;
        font-size: 0.7rem;
        margin-top: 3px;
        margin-left: 6px;
    }

    /* Compact spacing */
    .mb-3 {
        margin-bottom: 0.9rem !important;
    }
    .mb-4 {
        margin-bottom: 1.2rem !important;
    }

    @@media (max-width: 768px) {
        .content-wrapper {
            min-height: calc(100vh - 60px - 48px);
            padding: 0.75rem;
        }
        .card-body {
            padding: 1.2rem;
        }
    }
</style>

<div class="security-card">
    <div class="security-header">
        <div class="security-icon-circle">
            <i class="fas fa-shield-alt"></i>
        </div>
        <h4>Update Password</h4>
        <p>Protect your account</p>
    </div>

    <div class="card-body">
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-2"></i> @ViewBag.SuccessMessage
            </div>
        }

        @using (Html.BeginForm("ChangePassword", "UserPanel", FormMethod.Post, new { id = "passwordForm" }))
        {
            @Html.AntiForgeryToken()

            <!-- Current Password -->
            <div class="mb-3">
                @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Current password" })
                    <span class="input-group-text toggle-password"><i class="fas fa-eye"></i></span>
                </div>
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger" })
            </div>

            <hr>

            <!-- New Password -->
            <div class="mb-3">
                @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-key"></i></span>
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "New password" })
                    <span class="input-group-text toggle-password"><i class="fas fa-eye"></i></span>
                </div>
                <div class="password-requirement">
                    <i class="fas fa-info-circle me-1"></i> 8+ chars, mix of letters/numbers/symbols.
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password" })
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-update">
                <i class="fas fa-save me-2"></i> Save Changes
            </button>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.closest('.input-group').querySelector('input');
                const icon = this.querySelector('i');
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    input.type = "password";
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });
        });
    </script>
}