@{
    ViewBag.Title = "System Help & FAQ";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    /* ========== MODERN BLACK/PINK HELP PAGE ========== */
    :root {
        --theme-black: #0a0a0f;
        --theme-black-lighter: #14141c;
        --theme-dark-pink: #ff2b6e;
        --theme-pink-glow: rgba(255, 43, 110, 0.3);
        --theme-pink-soft: #ff5c8e;
        --theme-card-bg: #111117;
        --theme-border-subtle: #2a2a33;
    }

    .help-page-wrapper {
        background: radial-gradient(circle at 10% 20%, var(--theme-black) 0%, #050508 100%);
        padding: 2rem 0 4rem;
        margin-top: -1.5rem;
    }

    /* Header Section – refined */
    .help-header-section {
        background: linear-gradient(125deg, #0a0a0f 0%, #1a1a24 100%);
        color: white;
        padding: 4rem 2rem;
        border-radius: 32px;
        margin-bottom: -50px;
        text-align: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 45px -12px rgba(0,0,0,0.5);
        border: 1px solid rgba(255, 43, 110, 0.2);
    }

    .help-header-section::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -20%;
        width: 140%;
        height: 140%;
        background: radial-gradient(circle, rgba(255,43,110,0.08) 0%, rgba(0,0,0,0) 70%);
        pointer-events: none;
    }

    .help-header-section h1 {
        font-size: 3rem;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #fff 0%, var(--theme-dark-pink) 100%);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        margin-bottom: 1rem;
    }

    .help-header-section p {
        font-size: 1.1rem;
        opacity: 0.85;
        max-width: 600px;
        margin: 0 auto;
    }

    /* Search Box – elegant */
    .search-box-container {
        max-width: 620px;
        margin: 32px auto 0;
        position: relative;
    }

    .help-search-input {
        background: #0e0e16;
        border: 1px solid var(--theme-border-subtle);
        color: white;
        padding: 1rem 50px 1rem 1.5rem;
        border-radius: 60px;
        font-size: 1rem;
        transition: all 0.25s ease;
        width: 100%;
        outline: none;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    .help-search-input:focus {
        border-color: var(--theme-dark-pink);
        box-shadow: 0 0 0 4px var(--theme-pink-glow);
        background: #0e0e16;
    }

    .help-search-input::placeholder {
        color: #9ca3af;
    }

    .search-clear {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #9ca3af;
        cursor: pointer;
        transition: color 0.2s;
        font-size: 1.2rem;
        display: none;
        align-items: center;
        justify-content: center;
    }
    .search-clear:hover {
        color: var(--theme-dark-pink);
    }

    /* FAQ Container – dark glass */
    .faq-container {
        background: var(--theme-card-bg);
        border-radius: 32px;
        padding: 3rem 2.5rem;
        margin-top: 0;
        box-shadow: 0 25px 45px -12px rgba(0,0,0,0.6);
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(2px);
    }

    .faq-container h4 {
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(120deg, #fff, #ffd0dd);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        letter-spacing: -0.3px;
        margin-bottom: 2rem;
        border-left: 4px solid var(--theme-dark-pink);
        padding-left: 20px;
    }

    /* Accordion – modern */
    .accordion-item {
        background: #13131b;
        border: none;
        margin-bottom: 18px;
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 5px 12px rgba(0,0,0,0.2);
    }

    .accordion-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 22px -8px rgba(0,0,0,0.4);
        background: #181822;
    }

    .accordion-button {
        background: #13131b;
        color: #f0f0f3;
        font-weight: 600;
        padding: 1.2rem 1.8rem;
        font-size: 1rem;
        box-shadow: none !important;
        border-radius: 20px !important;
        transition: background 0.2s;
    }

    .accordion-button:not(.collapsed) {
        background: linear-gradient(95deg, var(--theme-dark-pink), #ff4d7a);
        color: white;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.1);
    }

    .accordion-button:focus {
        border-color: transparent;
        box-shadow: none;
    }

    .accordion-button::after {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23ffffff'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
        opacity: 0.8;
        transition: transform 0.3s;
    }

    .accordion-button:not(.collapsed)::after {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='white'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
    }

    .accordion-body {
        background: #0e0e16;
        color: #cbd5e1;
        padding: 1.5rem 1.8rem;
        font-size: 0.95rem;
        line-height: 1.6;
        border-top: 1px solid rgba(255,43,110,0.2);
    }

    .accordion-body strong {
        color: var(--theme-dark-pink);
    }

    /* No results */
    .no-results-message {
        background: rgba(255,43,110,0.08);
        border: 1px solid rgba(255,43,110,0.2);
        border-radius: 60px;
        padding: 1rem;
        text-align: center;
        color: #ffb7cc;
        margin-top: 1.5rem;
    }

    /* Contact Cards – glass with hover */
    .contact-card {
        background: rgba(20, 20, 32, 0.7);
        backdrop-filter: blur(8px);
        border: 1px solid #2a2a35;
        border-radius: 28px;
        padding: 2rem 1.5rem;
        text-align: center;
        transition: all 0.25s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        height: 100%;
    }

    .contact-card:hover {
        border-color: var(--theme-dark-pink);
        background: rgba(30, 30, 45, 0.9);
        transform: translateY(-6px);
        box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5);
    }

    .contact-icon {
        width: 64px;
        height: 64px;
        background: linear-gradient(145deg, var(--theme-dark-pink), #e21c5c);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 26px;
        box-shadow: 0 8px 14px rgba(255,43,110,0.3);
        transition: transform 0.2s;
    }

    .contact-card:hover .contact-icon {
        transform: scale(1.05);
    }

    .contact-card h6 {
        font-weight: 700;
        font-size: 1.2rem;
        color: white;
        margin-bottom: 12px;
    }

    .contact-card p {
        color: #a0a0b5;
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    hr {
        background: linear-gradient(90deg, transparent, var(--theme-dark-pink), transparent);
        height: 1px;
        opacity: 0.5;
        margin: 2.5rem 0;
    }

    .support-headline {
        font-size: 1.6rem;
        font-weight: 700;
        background: linear-gradient(135deg, #fff, #ffb0c3);
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
    }

    .bg-pink-glow {
        background: var(--theme-pink-glow);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .help-header-section {
            padding: 2.5rem 1.5rem;
        }
        .help-header-section h1 {
            font-size: 2.2rem;
        }
        .faq-container {
            padding: 2rem 1.5rem;
        }
        .faq-container h4 {
            font-size: 1.6rem;
        }
        .accordion-button {
            padding: 1rem 1.2rem;
            font-size: 0.9rem;
        }
        .contact-card {
            padding: 1.5rem;
        }
        .contact-icon {
            width: 52px;
            height: 52px;
            font-size: 22px;
        }
    }

    @@media (max-width: 576px) {
        .help-header-section h1 {
            font-size: 1.8rem;
        }
        .faq-container h4 {
            font-size: 1.4rem;
        }
    }
</style>

<div class="help-page-wrapper">
    <!-- Header Section -->
    <div class="container">
        <div class="help-header-section">
            <h1>
                <i class="fas fa-life-ring me-2" style="color: var(--theme-dark-pink); filter: drop-shadow(0 0 6px rgba(255,43,110,0.5));"></i>
                How can we help?
            </h1>
            <p>Search for answers, explore common questions, or reach out to our support team.</p>

            <div class="search-box-container">
                <input type="text" id="faqSearch" class="help-search-input" placeholder="🔍 Type your question (e.g., 'password', 'profile', 'dashboard')...">
                <button id="clearSearch" class="search-clear" aria-label="Clear search">✖</button>
            </div>
        </div>
    </div>

    <!-- FAQ Accordion Container -->
    <div class="container mb-5">
        <div class="faq-container">
            <h4>
                <i class="fas fa-question-circle me-2" style="color: var(--theme-dark-pink);"></i>
                Frequently Asked Questions
            </h4>

            <div class="accordion" id="helpAccordion">
                <!-- Q1: Password Change -->
                <div class="accordion-item" data-search="password change security">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                            <i class="fas fa-key me-3" style="color: var(--theme-dark-pink);"></i> How do I change my password?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#helpAccordion">
                        <div class="accordion-body">
                            To change your password, click on the <strong>Security</strong> link in the left sidebar. You will need to enter your current password, followed by your new password twice to confirm it. For security, ensure your new password is at least 8 characters with mixed case and numbers.
                        </div>
                    </div>
                </div>

                <!-- Q2: Profile Update -->
                <div class="accordion-item" data-search="profile update name email">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                            <i class="fas fa-user-edit me-3" style="color: var(--theme-dark-pink);"></i> How do I update my profile details?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                        <div class="accordion-body">
                            Navigate to the <strong>My Profile</strong> page using the left sidebar menu. You can update your Full Name and Email address. Your Applicant ID and status are locked for security. Changes reflect across the system within minutes.
                        </div>
                    </div>
                </div>

                <!-- Q3: Dashboard Navigation -->
                <div class="accordion-item" data-search="dashboard navigation menu">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                            <i class="fas fa-tachometer-alt me-3" style="color: var(--theme-dark-pink);"></i> How do I navigate the dashboard?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                        <div class="accordion-body">
                            The dashboard gives you a quick overview of your applications, scheduled interviews, and recent activity. Use the left sidebar to access all modules: Dashboard, Vacancies, My Applications, Profile, Security, and Help.
                        </div>
                    </div>
                </div>

                <!-- Q4: Account Lockout -->
                <div class="accordion-item" data-search="lockout account locked forgot password">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour">
                            <i class="fas fa-lock me-3" style="color: var(--theme-dark-pink);"></i> What should I do if I get locked out of my account?
                        </button>
                    </h2>
                    <div id="collapseFour" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                        <div class="accordion-body">
                            If you are locked out after multiple failed login attempts, click <strong>"Forgot Password?"</strong> on the login page to receive a password reset link via your registered email. Alternatively, contact our support team for immediate assistance.
                        </div>
                    </div>
                </div>

                <!-- Q5: Applying for a vacancy -->
                <div class="accordion-item" data-search="apply vacancy job application">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFive">
                            <i class="fas fa-paper-plane me-3" style="color: var(--theme-dark-pink);"></i> How do I apply for a job?
                        </button>
                    </h2>
                    <div id="collapseFive" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                        <div class="accordion-body">
                            Browse open vacancies from the <strong>Vacancies</strong> page. Click on a vacancy to see full details, then click <strong>Apply Now</strong>. Your application will be sent to the HR department, and you can track its status in <strong>My Applications</strong>.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Support Section -->
            <hr>
            <div class="row text-center g-4">
                <div class="col-12">
                    <h5 class="support-headline">✨ Still need assistance? ✨</h5>
                    <p class="text-muted mt-2">Our support teams are available Monday to Friday, 9am – 5pm (EST).</p>
                </div>
                <div class="col-md-4">
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-headset"></i></div>
                        <h6>IT Helpdesk</h6>
                        <p class="small">support@abccompany.com</p>
                        <span class="badge bg-pink-glow mt-2" style="background: rgba(255,43,110,0.2); color:#ff9abb;">Priority support</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-building"></i></div>
                        <h6>HR Support</h6>
                        <p class="small">hr-help@abccompany.com</p>
                        <span class="badge bg-pink-glow mt-2" style="background: rgba(255,43,110,0.2); color:#ff9abb;">Policy & payroll</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-comments"></i></div>
                        <h6>Live Chat</h6>
                        <p class="small">Available on the Intranet</p>
                        <span class="badge bg-pink-glow mt-2" style="background: rgba(255,43,110,0.2); color:#ff9abb;">Quick response</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('faqSearch');
            const clearBtn = document.getElementById('clearSearch');
            const faqItems = document.querySelectorAll('.accordion-item');
            const accordionContainer = document.querySelector('.accordion');

            function filterFAQs() {
                const term = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                faqItems.forEach(item => {
                    const title = item.querySelector('.accordion-button')?.innerText.toLowerCase() || '';
                    const body = item.querySelector('.accordion-body')?.innerText.toLowerCase() || '';
                    const dataSearch = item.getAttribute('data-search')?.toLowerCase() || '';
                    const fullText = title + ' ' + body + ' ' + dataSearch;

                    const matches = term === '' || fullText.includes(term);
                    item.style.display = matches ? '' : 'none';
                    if (matches) visibleCount++;
                });

                clearBtn.style.display = term.length > 0 ? 'flex' : 'none';

                let noResultMsg = document.querySelector('.no-results-message');
                if (visibleCount === 0 && term !== '') {
                    if (!noResultMsg) {
                        noResultMsg = document.createElement('div');
                        noResultMsg.className = 'no-results-message';
                        noResultMsg.innerHTML = '<i class="fas fa-search-minus me-2"></i> No matching questions found. Try different keywords or contact support.';
                        accordionContainer.appendChild(noResultMsg);
                    }
                } else if (noResultMsg) {
                    noResultMsg.remove();
                }
            }

            searchInput.addEventListener('input', filterFAQs);
            clearBtn.addEventListener('click', function() {
                searchInput.value = '';
                filterFAQs();
                searchInput.focus();
            });
        });
    </script>
}