@model HRRecruitment.Models.Applicant
@{
    ViewData["Title"] = "Applicant Details";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1"><i class="fas fa-user me-2 text-primary"></i>Applicant Details</h4>
                    <p class="text-muted mb-0">@Model.ApplicantNumber - @Model.FirstName @Model.LastName</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr><th>Applicant Number</th><td>@Model.ApplicantNumber</td></tr>
                        <tr><th>Full Name</th><td>@Model.FirstName @Model.LastName</td></tr>
                        <tr><th>Email</th><td>@Model.Email</td></tr>
                        <tr><th>Phone</th><td>@Model.Phone</td></tr>
                        <tr><th>Address</th><td>@(Model.Address ?? "N/A")</td></tr>
                        <tr><th>Status</th><td><span class="badge @(Model.Status == "Hired" ? "bg-success" : (Model.Status == "In Process" ? "bg-primary" : "bg-secondary"))">@Model.Status</span></td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Professional Details</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tr><th>Highest Qualification</th><td>@(Model.HighestQualification ?? "N/A")</td></tr>
                        <tr><th>Experience (Years)</th><td>@(Model.ExperienceYears?.ToString() ?? "0")</td></tr>
                        <tr><th>Current Company</th><td>@(Model.CurrentCompany ?? "N/A")</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Applicants")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Applicants
        </a>
    </div>
</div>