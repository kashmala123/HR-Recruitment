@model IEnumerable<HRRecruitment.Models.Interview>
@{
    ViewData["Title"] = "Completed Interviews";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1"><i class="fas fa-check-circle me-2 text-success"></i>Completed Interviews</h4>
                    <p class="text-muted mb-0">View your completed interviews history</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Interview #</th>
                                <th>Date</th>
                                <th>Applicant</th>
                                <th>Position</th>
                                <th>Result</th>
                                <th>Feedback</th>
                                <th>Completed On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var interview in Model)
                            {
                                <tr>
                                    <td>@interview.InterviewNumber</td>
                                    <td>@interview.InterviewDate.ToString("dd MMM yyyy")</td>
                                    <td>@(interview.ApplicantVacancy?.Applicant?.FullName ?? "N/A")</td>
                                    <td>@(interview.ApplicantVacancy?.Vacancy?.JobTitle ?? "N/A")</td>
                                    <td>
                                        @if (interview.Result == "Selected")
                                        {
                                            <span class="badge bg-success">Selected</span>
                                        }
                                        else if (interview.Result == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@interview.Result</span>
                                        }
                                    </td>
                                    <td>@(interview.Feedback ?? "-")</td>
                                    <td>@(interview.CompletedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle me-2"></i> No completed interviews yet.
        </div>
    }

    <div class="mt-3">
        <a href="@Url.Action("MyInterviews")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to My Interviews
        </a>
    </div>
</div>