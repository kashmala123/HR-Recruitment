@model HRRecruitment.Models.Interview
@{
    ViewData["Title"] = "Interview Details";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1">Interview Details</h4>
                    <p class="text-muted mb-0">Interview #: @Model.InterviewNumber</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Interview Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Date:</strong> @Model.InterviewDate.ToString("dd MMM yyyy")</p>
                    <p><strong>Time:</strong> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</p>
                    <p><strong>Mode:</strong> @Model.InterviewMode</p>
                    <p><strong>Round:</strong> Round @Model.InterviewRound</p>
                    <p><strong>Status:</strong> <span class="badge bg-success">@Model.Status</span></p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Applicant Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.ApplicantVacancy?.Applicant?.FirstName @Model.ApplicantVacancy?.Applicant?.LastName</p>
                    <p><strong>Email:</strong> @Model.ApplicantVacancy?.Applicant?.Email</p>
                    <p><strong>Phone:</strong> @Model.ApplicantVacancy?.Applicant?.Phone</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Vacancy Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Position:</strong> @Model.ApplicantVacancy?.Vacancy?.JobTitle</p>
                    <p><strong>Department:</strong> @Model.ApplicantVacancy?.Vacancy?.Department?.DepartmentName</p>
                    <p><strong>Description:</strong> @Model.ApplicantVacancy?.Vacancy?.JobDescription</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Status == "Scheduled")
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header" style="background:#1e2b4f; color:white;">
                        <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>Submit Result</h5>
                    </div>
                    <div class="card-body">
                        <form asp-action="SubmitResult" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.InterviewId" />
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Decision</label>
                                    <div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="result" value="Selected" id="select">
                                            <label class="form-check-label" for="select">Select</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="result" value="Rejected" id="reject">
                                            <label class="form-check-label" for="reject">Reject</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label fw-bold">Feedback</label>
                                    <textarea name="feedback" class="form-control" rows="4" placeholder="Enter your feedback..."></textarea>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">Submit Result</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-3">
        <div class="col-12">
            <a href="@Url.Action("MyInterviews")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to My Interviews
            </a>
        </div>
    </div>
</div>