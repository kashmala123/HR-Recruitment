@model HRRecruitment.Models.Vacancy
@{
    ViewData["Title"] = "Vacancy Details";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
    ViewBag.Interviewer = ViewBag.Interviewer;
}

<div class="container-fluid px-0">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h4 class="mb-1"><i class="fas fa-briefcase me-2 text-primary"></i>Vacancy Details</h4>
                        <p class="text-muted mb-0">@Model.VacancyNumber - @Model.JobTitle</p>
                    </div>
                    <a href="@Url.Action("Vacancies", "Interviewer")" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Vacancies
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Vacancy Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 200px;">Vacancy Number</th>
                            <td>@Model.VacancyNumber</td>
                        </tr>
                        <tr>
                            <th>Job Title</th>
                            <td>@Model.JobTitle</td>
                        </tr>
                        <tr>
                            <th>Department</th>
                            <td>@(Model.Department?.DepartmentName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th>Total Openings</th>
                            <td>@Model.TotalOpenings</td>
                        </tr>
                        <tr>
                            <th>Remaining Openings</th>
                            <td>@Model.RemainingOpenings</td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.Status == "Open")
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                                else if (Model.Status == "Closed")
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Model.Status</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Created Date</th>
                            <td>@Model.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                        @if (Model.ClosingDate.HasValue)
                        {
                            <tr>
                                <th>Closing Date</th>
                                <td>@Model.ClosingDate.Value.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </table>

                    <h6 class="mt-4">Job Description</h6>
                    <p class="text-muted">@(Model.JobDescription ?? "Not specified")</p>

                    <h6 class="mt-4">Required Qualifications</h6>
                    <p class="text-muted">@(Model.RequiredQualifications ?? "Not specified")</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header" style="background:rgba(255,43,110,0.12);">
                    <h5 class="mb-0">Quick Stats</h5>
                </div>
                <div class="card-body text-center">
                    <h3 class="text-primary">@(Model.ApplicantVacancies?.Count ?? 0)</h3>
                    <p class="text-muted mb-3">Total Applicants</p>
                    <h3>@Model.RemainingOpenings</h3>
                    <p class="text-muted mb-0">Remaining Openings</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header" style="background:rgba(255,43,110,0.12);">
                    <h5 class="mb-0"><i class="fas fa-users me-2"></i>Attached Applicants</h5>
                </div>
                <div class="card-body">
                    @if (Model.ApplicantVacancies != null && Model.ApplicantVacancies.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Applicant #</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Qualification</th>
                                        <th>Attached Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var av in Model.ApplicantVacancies)
                                    {
                                        <tr>
                                            <td>@av.Applicant?.ApplicantNumber</td>
                                            <td>@(av.Applicant?.FirstName) @(av.Applicant?.LastName)</td>
                                            <td>@av.Applicant?.Email</td>
                                            <td>@(av.Applicant?.HighestQualification ?? "-")</td>
                                            <td>@av.AttachedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (av.CurrentStatus == "Selected")
                                                {
                                                    <span class="badge bg-success">Selected</span>
                                                }
                                                else if (av.CurrentStatus == "Rejected")
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                                else if (av.CurrentStatus == "Interview Scheduled")
                                                {
                                                    <span class="badge bg-info">Interview Scheduled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@(av.CurrentStatus ?? "Applied")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (av.Applicant != null)
                                                {
                                                    <a href="@Url.Action("ApplicantDetails", "Interviewer", new { id = av.Applicant.ApplicantId })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-eye"></i> View
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 text-center py-3">No applicants attached to this vacancy yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
