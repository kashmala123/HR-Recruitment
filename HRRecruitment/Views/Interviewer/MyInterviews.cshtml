@model IEnumerable<HRRecruitment.Models.Interview>
@{
    ViewData["Title"] = "My Interviews";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
    var searchString = Context.Request.Query["searchString"].ToString();
}

<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1"><i class="fas fa-calendar-alt me-2 text-primary"></i>My Interviews</h4>
                    <p class="text-muted mb-0">View and manage your scheduled interviews</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-10">
                            <input type="text" name="searchString" class="form-control"
                                   placeholder="Search by applicant name, vacancy title, date..."
                                   value="@searchString" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Interviews List -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
<th>Interview #</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Applicant</th>
                                    <th>Position</th>
                                    <th>Mode</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                    @foreach (var interview in Model)
                                    {
                                        <tr>
                                            <td><strong>@interview.InterviewNumber</strong></td>
                                            <td>@interview.InterviewDate.ToString("dd MMM yyyy")</td>
                                            <td>@interview.StartTime.ToString(@"hh\:mm") - @interview.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@(interview.ApplicantVacancy?.Applicant?.FullName ?? "N/A")</td>
                                            <td>@(interview.ApplicantVacancy?.Vacancy?.JobTitle ?? "N/A")</td>
                                            <td><span class="badge bg-info">@interview.InterviewMode</span></td>
                                            <td>
                                                @if (interview.Status == "Scheduled")
                                                {
                                                    <span class="badge bg-success">Scheduled</span>
                                                }
                                                else if (interview.Status == "Completed")
                                                {
                                                    <span class="badge bg-primary">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@interview.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("InterviewDetails", new { id = interview.InterviewId })"
                                                       class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No interviews scheduled</h5>
                            <p class="text-muted">You have no upcoming interviews at the moment.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>