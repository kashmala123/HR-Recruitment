@model IEnumerable<HRRecruitment.Models.Vacancy>
@{
    ViewData["Title"] = "Vacancies";
    Layout = "~/Views/Shared/_InterviewerLayout.cshtml";
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="mb-1"><i class="fas fa-briefcase me-2 text-primary"></i>Job Vacancies</h4>
                    <p class="text-muted mb-0">View all available job vacancies</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    @{
        var vacancies = Model?.ToList() ?? new List<HRRecruitment.Models.Vacancy>();
        var totalCount = vacancies.Count;
        var openCount = vacancies.Count(v => v.Status == "Open");
        var totalOpenings = vacancies.Sum(v => v.RemainingOpenings);
        var totalApplicants = vacancies.Sum(v => v.ApplicantVacancies?.Count ?? 0);
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h3 class="text-primary mb-0">@totalCount</h3>
                    <p class="text-muted mb-0">Total Vacancies</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h3 class="text-success mb-0">@openCount</h3>
                    <p class="text-muted mb-0">Open</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h3 class="text-warning mb-0">@totalOpenings</h3>
                    <p class="text-muted mb-0">Openings</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow text-center">
                <div class="card-body">
                    <h3 class="text-info mb-0">@totalApplicants</h3>
                    <p class="text-muted mb-0">Applicants</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Box -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-10">
                            <input type="text" name="searchTerm" class="form-control"
                                   placeholder="Search by vacancy number or title..."
                                   value="@Context.Request.Query["searchTerm"]" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Vacancies Table -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Vacancies List</h5>
                </div>
                <div class="card-body">
                    @if (vacancies.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Vacancy #</th>
                                        <th>Title</th>
                                        <th>Department</th>
                                        <th>Openings</th>
                                        <th>Status</th>
                                        <th>Created Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vacancy in vacancies)
                                    {
                                        <tr>
                                            <td><strong>@vacancy.VacancyNumber</strong></td>
                                            <td>@vacancy.JobTitle</td>
                                            <td>@(vacancy.Department?.DepartmentName ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @vacancy.RemainingOpenings/@vacancy.TotalOpenings
                                                </span>
                                            </td>
                                            <td>
                                                @if (vacancy.Status == "Open")
                                                {
                                                    <span class="badge bg-success">Open</span>
                                                }
                                                else if (vacancy.Status == "Closed")
                                                {
                                                    <span class="badge bg-secondary">Closed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">@vacancy.Status</span>
                                                }
                                            </td>
                                            <td>@vacancy.CreatedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a href="@Url.Action("VacancyDetails", "Interviewer", new { id = vacancy.VacancyId })"
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-briefcase fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No vacancies found</h5>
                            <p class="text-muted">There are no vacancies available at the moment.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>